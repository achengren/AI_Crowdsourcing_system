NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=hib_session
# Production defaults to true. Set false only for an HTTP-only test deployment.
AUTH_COOKIE_SECURE=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=replace-with-existing-root-password
DB_USER=ai_crowdsourcing
DB_PASSWORD=replace-with-database-password
DB_NAME=ai_crowdsourcing
DB_APP_HOST=%
DB_POOL_SIZE=15

ADMIN_STUDENT_ID=admin
ADMIN_NAME=系统管理员
ADMIN_PASSWORD=replace-with-an-initial-password

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=replace-with-deepseek-model
OLLAMA_BASE_URL=http://replace-with-ollama-host:11434/v1
OLLAMA_TEXT_MODEL=replace-with-ollama-text-model
VISION_MODEL=replace-with-vision-model
TITLE_MODEL=replace-with-title-model
AI_CONTEXT_TOKEN_BUDGET=16000
AI_TEXT_TIMEOUT_MS=45000
AI_VISION_TIMEOUT_MS=60000
AI_TITLE_TIMEOUT_MS=3500
AI_TEXT_MAX_RETRIES=1
AI_VISION_MAX_RETRIES=1
AI_MAX_CONCURRENCY=25
AI_MAX_PER_USER=2
STORAGE_DRIVER=local
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: only used to read legacy records that stored a public S3 URL.
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=uploads
