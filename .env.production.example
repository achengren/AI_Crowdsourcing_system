NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://example.com
JWT_SECRET=replace-with-at-least-32-random-characters

MYSQL_ROOT_PASSWORD=replace-with-a-separate-mysql-root-password
DB_HOST=mysql
DB_PORT=3306
DB_USER=ai_crowdsourcing
DB_PASSWORD=replace-with-a-strong-application-database-password
DB_NAME=ai_crowdsourcing
